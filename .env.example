# ── Groq API Key ───────────────────────────────────────────
# Get your free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Google BigQuery Settings ──────────────────────────────
BIGQUERY_PROJECT_ID=retailiq-analytics-508120

# ── Local Development Credentials Path ───────────────────
# Path to your downloaded service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/bigquery_key.json

# ── Render / Cloud Hosting (Optional Alternative) ────────
# Paste the full raw JSON contents of your key directly into this env var
# GCP_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
